{
  "name": "@metonymous/buddykit",
  "version": "0.1.1",
  "description": "Parametric expressive identity for AI companions — a living core-and-shell character from a seed and a handful of traits. 2D, spring-animated, zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "vite demo",
    "demo:build": "vite build demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iantbutler01/buddykit.git"
  },
  "homepage": "https://github.com/iantbutler01/buddykit"
}
